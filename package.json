{
  "name": "bbw-checkout",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test dist/test/*.test.js scripts/*.test.mjs",
    "sentry:upload": "node --env-file-if-exists=.env scripts/upload-sourcemaps.mjs",
    "sentry:bridge": "node --env-file-if-exists=.env scripts/sentry-to-issue.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@sentry/node": "11.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sentry/cli": "3.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
