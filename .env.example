PORT=3003
CORS_ORIGIN=http://localhost:3000
USERS_URL=http://localhost:3001
CATALOG_URL=http://localhost:3002
DEPENDENCY_TIMEOUT_MS=2000

# DSN do projeto bbw-checkout na organização bbdw-workshop-jj.
SENTRY_DSN=
SENTRY_ENVIRONMENT=bbw-demo
# Use o SHA exato da revisão executada.
SENTRY_RELEASE=
DEMO_SCENARIO=CHK-001
# Identificador novo por ensaio/apresentação; use somente letras, números e hífens.
DEMO_RUN_ID=ensaio-001

# A publicação usa o App GitHub do Sentry; não precisa de processo local.
# SENTRY_AUTH_TOKEN fica nos secrets do GitHub, apenas para o job prepare.
